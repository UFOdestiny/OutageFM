# Optional settings for the shell drivers (scripts/common.sh); copy to .env. Unset values use the defaults below.
# Python interpreter of the environment that has outagefm installed.
PYTHON=python
# Number of GPUs for training and evaluation (default: all visible to PyTorch).
# NGPU=2
# Global batch of every reported OutageFM run; per-GPU batch and gradient accumulation follow from it.
GLOBAL_BATCH=8192
# Parallel downloads for the weather archives (scripts/prepare_data.sh weather).
WEATHER_WORKERS=8
